#!/bin/sh
# Grader-side job store.  Reads the approval bundle from stdin.
set -u

MODULE='gate.store_job'
MODULE_FILE='gate/store_job.py'
INSTALL_ROOT="${TW_INSTALL_ROOT:-/opt/test-writer}"
PYTHON="$INSTALL_ROOT/venv/bin/python"

if [ ! -x "$PYTHON" ] || [ ! -f "$INSTALL_ROOT/$MODULE_FILE" ] || [ ! -d "$INSTALL_ROOT/grader" ]; then
  printf '%s\n' '{"message":"The Test-Writer runtime is not installed.","ok":false,"reason":"RUNTIME_UNAVAILABLE"}'
  exit 78
fi

PYTHONPATH="$INSTALL_ROOT"
export PYTHONPATH
exec "$PYTHON" -m "$MODULE" "$@"
