{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NyxowlConfiguration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1, "default": 1 },
    "preferredHost": {
      "type": ["string", "null"],
      "enum": ["claude", "opencode", "codex", "gemini", "antigravity", "cursor", "windsurf", null],
      "default": null
    },
    "baseBranch": { "type": "string", "default": "auto" },
    "protectedBranches": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["main", "master", "production"]
    },
    "worktreeRoot": {
      "type": "string",
      "enum": ["auto", "external", "in-repo"],
      "default": "auto"
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typecheck": { "type": ["string", "null"], "default": null },
        "lint": { "type": ["string", "null"], "default": null },
        "test": { "type": ["string", "null"], "default": null },
        "build": { "type": ["string", "null"], "default": null }
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "string", "enum": ["auto", "off"], "default": "auto" },
        "linkEnv": { "type": "boolean", "default": true }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": { "type": "string", "enum": ["required", "auto", "off"], "default": "required" },
        "seam": { "type": "string", "enum": ["required", "auto", "off"], "default": "required" },
        "slop": { "type": "string", "enum": ["required", "auto", "off"], "default": "required" },
        "exploit": { "type": "string", "enum": ["required", "auto", "off"], "default": "auto" }
      }
    },
    "slop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "enum": ["diff", "full"], "default": "diff" },
        "disable": { "type": "array", "items": { "type": "string" }, "default": [] },
        "advisoryAsBlocking": { "type": "boolean", "default": false }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "app", "gh", "local"], "default": "auto" },
        "attribution": { "type": "string", "enum": ["coauthor", "none"], "default": "coauthor" },
        "appId": { "type": ["string", "null"], "default": null }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxToolOutputTokens": { "type": "integer", "minimum": 100, "default": 1500 },
        "subagentSummaryTokens": { "type": "integer", "minimum": 50, "default": 250 },
        "handoffTokens": { "type": "integer", "minimum": 100, "default": 400 },
        "agentPromptTokens": { "type": "integer", "minimum": 200, "default": 1200 },
        "maxToolCallsPerTask": { "type": "integer", "minimum": 10, "default": 400 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depGuard": { "type": "string", "enum": ["fail-closed", "warn"], "default": "fail-closed" },
        "webFetchAllow": { "type": "array", "items": { "type": "string" }, "default": [] },
        "webFetchDeny": { "type": "array", "items": { "type": "string" }, "default": [] },
        "maxQueryChars": { "type": "integer", "minimum": 16, "default": 256 }
      }
    },
    "deps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" }, "default": [] },
        "deny": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedHosts": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["127.0.0.1", "localhost", "::1"]
        }
      }
    }
  }
}
