{
  "name": "nyxowl",
  "version": "1.0.0",
  "description": "Zero-Slop, Stack-Agnostic, Security-Hardened, Token-Efficient Product & Engineering Team (1 Primary Agent + 9 Specialized Subagents) backed by a 7-Engine Heavy Runtime MCP Server",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "nyxowl": "./dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/cli/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "dist",
    "agents",
    "skills-vendor",
    "schemas",
    "data",
    "templates",
    "docs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:node": "node --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@vscode/ripgrep": "^1.15.9",
    "jsonc-parser": "^3.3.1",
    "linkedom": "^0.18.9",
    "semver": "^7.7.1",
    "shell-quote": "^1.8.2",
    "smol-toml": "^1.3.1",
    "typescript": "^5.8.2",
    "ulid": "^2.3.0",
    "web-tree-sitter": "^0.24.7",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "tsup": "^8.4.0",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
